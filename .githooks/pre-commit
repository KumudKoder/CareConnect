#!/usr/bin/env sh
# CareConnect pre-commit hook
# Runs a lightweight staged secret scan before allowing commit.

if [ -x "./.venv/Scripts/python.exe" ]; then
  ./.venv/Scripts/python.exe .githooks/secret_scan.py
  exit $?
fi

if [ -x "./CareConnect-Backend/venv/Scripts/python.exe" ]; then
  ./CareConnect-Backend/venv/Scripts/python.exe .githooks/secret_scan.py
  exit $?
fi

echo "[secret-scan] Python runtime not found in repo environments (.venv or CareConnect-Backend/venv). Skipping local secret scan; CI scan will still run."
exit 0
